SUB2API_BASE_URL=https://sub2api.yjkj02.com
SUB2API_MODEL=gpt-5.6-sol
# Secrets in private, untracked .env; never copy Feishu secrets here.
SUB2API_API_KEY=
X_BEARER_TOKEN=
# Must be the local Hermes runtime file on the Docker host (read-only bind mount).
HERMES_FEISHU_ENV_FILE=/absolute/path/to/.hermes/.env
# Set these to the owner UID/GID of the above file, e.g. from `stat -c '%u %g'`.
HERMES_UID=
HERMES_GID=
# Dedicated writable state directory owned by HERMES_UID:HERMES_GID.
WATCH_DATA_DIR=/absolute/path/to/private/watcher-state
WATCH_INTERVAL=5m
